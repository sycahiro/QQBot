# Private durable data and operational files
/.workbuddy/
/QQBot.lnk
**/.pytest_cache/
**/.ruff_cache/
/data/**
!/data/README.md
/logs/**
!/logs/README.md
/cache/**
!/cache/README.md
/temp/**
!/temp/README.md
/runtime/**
!/runtime/README.md
/build/**
!/build/README.md
/reports/validation/**
/reports/diagnostics/**

# External source/runtime repositories are tracked independently
/src/SnowLuma/
/upstream/
/backup/
/tools/node/
# 便携 CPython 本体不入库，只保留依赖清单
/tools/python/*
!/tools/python/requirements.txt

# Local dependency trees and credential files
**/node_modules/
**/.env
**/.env.local
**/*.local.json

# Python build artifacts
**/__pycache__/
**/*.pyc
**/*.pyo

# Frontend build output (generated by vite, not tracked)
/src/DesktopShell/frontend/dist/
